version 0.1
namespace acm

import rbac


// Extend RBAC model
// @rbac.add_permission(name:'create_deployment')
// @rbac.add_permission(name:'create_vm')
// public type cluster {
//     relation workspace: [ExactlyOne rbac.workspace]

//     // Define cluster-level permissions,
//     // which are inherited from the workspace-level permissions
//     // that we defined above.
//     relation create_deployment: workspace.create_deployment or user_grant.create_deployment
//     relation create_vm: workspace.create_vm or user_grant.create_deployment
//     relation user_grant: [Any rbac.role_binding]
// }


// public type k8s_namespace {
//     relation workspace: [ExactlyOne rbac.workspace]
//     relation cluster: [ExactlyOne cluster]

//     // Define k8s_namespace-level permissions,
//     // which are inherited from the cluster-level permissions
//     // that we defined above.
//     relation create_deployment: cluster.create_deployment or user_grant.create_deployment
//     relation create_vm: cluster.create_vm or user_grant.create_deployment
//     relation user_grant: [Any rbac.role_binding]
// }

public type k8s_cluster {
    relation workspace:  [ExactlyOne rbac.workspace]
    relation user_grant: [Any rbac.role_binding]
}

public type k8s_namespace {
    relation workspace:  [ExactlyOne rbac.workspace]
    relation cluster:  [ExactlyOne k8s_cluster]
    relation user_grant: [Any rbac.role_binding]
}

@rbac.add_permission(name:'create_deployment')
@rbac.add_permission(name:'create_vm')
@add_permission(name:'create_deployment')
@add_permission(name:'create_vm')
public type test_acm{
}

public extension add_permission(name) {
    type k8s_cluster{
        internal relation `${name}`: user_grant.`${name}` or workspace.`${name}`
    }

    type k8s_namespace{
        internal relation `${name}`: user_grant.`${name}` or workspace.`${name}` or cluster.`${name}`
    }
}
