version 0.1
namespace acm

import rbac

public type k8s_cluster {
    relation workspace:  [ExactlyOne rbac.workspace]
    relation user_grant: [Any rbac.role_binding]
}

public type k8s_namespace {
    relation workspace:  [ExactlyOne rbac.workspace]
    relation cluster:  [ExactlyOne k8s_cluster]
    relation user_grant: [Any rbac.role_binding]
}

// cluster scope permission
public extension add_cluster_permission(name) {
    type k8s_cluster{
        internal relation `${name}`: user_grant.`${name}` or workspace.`${name}`
    }
}

// namespace scope permission
public extension add_ns_permission(name) {
    type k8s_cluster{
        internal relation `${name}`: user_grant.`${name}` or workspace.`${name}`
    }

    type k8s_namespace{
        internal relation `${name}`: user_grant.`${name}` or workspace.`${name}` or cluster.`${name}`
    }
}

// Extend RBAC model with relevant permissions
@rbac.add_permission(name:'create_vm')
@rbac.add_permission(name:'create_deployment')
@rbac.add_permission(name:'create_secret')
@rbac.add_permission(name:'create_clusterrole')
// Extend k8s_cluster and k8s_namespace
@add_ns_permission(name:'create_vm')
@add_ns_permission(name:'create_deployment')
@add_ns_permission(name:'create_secret')
@add_cluster_permission(name:'create_clusterrole')
public type test_acm{
}
