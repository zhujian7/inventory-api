definition acm/k8s_cluster {
	permission create_clusterrole = t_user_grant->create_clusterrole + t_workspace->create_clusterrole
	permission create_deployment = t_user_grant->create_deployment + t_workspace->create_deployment
	permission create_secret = t_user_grant->create_secret + t_workspace->create_secret
	permission create_vm = t_user_grant->create_vm + t_workspace->create_vm
	permission user_grant = t_user_grant
	relation t_user_grant: rbac/role_binding
	permission workspace = t_workspace
	relation t_workspace: rbac/workspace
}

definition acm/k8s_namespace {
	permission cluster = t_cluster
	relation t_cluster: acm/k8s_cluster
	permission create_deployment = t_user_grant->create_deployment + t_workspace->create_deployment + t_cluster->create_deployment
	permission create_secret = t_user_grant->create_secret + t_workspace->create_secret + t_cluster->create_secret
	permission create_vm = t_user_grant->create_vm + t_workspace->create_vm + t_cluster->create_vm
	permission user_grant = t_user_grant
	relation t_user_grant: rbac/role_binding
	permission workspace = t_workspace
	relation t_workspace: rbac/workspace
}

definition acm/test_acm {}

definition kessel/lock {
	permission version = t_version
	relation t_version: kessel/lockversion
}

definition kessel/lockversion {}

definition rbac/group {
	permission member = t_member
	relation t_member: rbac/principal | rbac/group#member
}

definition rbac/principal {}

definition rbac/role {
	permission create_clusterrole = t_create_clusterrole
	relation t_create_clusterrole: rbac/principal:*
	permission create_deployment = t_create_deployment
	relation t_create_deployment: rbac/principal:*
	permission create_secret = t_create_secret
	relation t_create_secret: rbac/principal:*
	permission create_vm = t_create_vm
	relation t_create_vm: rbac/principal:*
}

definition rbac/role_binding {
	permission create_clusterrole = (subject & t_granted->create_clusterrole)
	permission create_deployment = (subject & t_granted->create_deployment)
	permission create_secret = (subject & t_granted->create_secret)
	permission create_vm = (subject & t_granted->create_vm)
	permission granted = t_granted
	relation t_granted: rbac/role
	permission subject = t_subject
	relation t_subject: rbac/principal | rbac/group#member
}

definition rbac/workspace {
	permission create_clusterrole = t_user_grant->create_clusterrole + t_parent->create_clusterrole
	permission create_deployment = t_user_grant->create_deployment + t_parent->create_deployment
	permission create_secret = t_user_grant->create_secret + t_parent->create_secret
	permission create_vm = t_user_grant->create_vm + t_parent->create_vm
	permission parent = t_parent
	relation t_parent: rbac/workspace
	permission user_grant = t_user_grant
	relation t_user_grant: rbac/role_binding
}